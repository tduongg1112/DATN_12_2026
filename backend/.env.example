# Mẫu biến môi trường của backend. Chép thành .env rồi điền giá trị.
# Khoá để trống là khoá bí mật hoặc chưa có giá trị: tự điền, không commit .env.

NODE_ENV=development
# TD-06: frontend 3000, backend 4000, AI service 8000
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL (docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=da_2026

# --- Redis (TD-03: lưu refresh token) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (TD-12; TD-16: access 30 phút, refresh 7 ngày). Secret tối thiểu 32 ký tự, vd: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Tài khoản (OQ-02): sai 5 lần liên tiếp thì khoá 15 phút ---
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

# --- Tài khoản ADMIN tạo bằng `npm run seed` (BR-G02) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google OAuth (TD-13, TD-22). Để trống thì nút Google chuyển về /login?error=google ---
# GOOGLE_CALLBACK_URL khai báo y hệt trong Google Cloud Console, vd
# http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- AI service (technical_overview mục 5, TD-04) ---
# mock: không cần AI service thật; http: gọi AI_SERVICE_URL
AI_MODE=mock
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=15000
AI_TOP_K=3
# OQ-06: một ngưỡng chung trong [0,1]. Giá trị chờ nhóm AI, để trống được.
AI_CONFIDENCE_THRESHOLD=
# Chỉ dùng khi AI_MODE=mock: ok | error | timeout | invalid_image | unknown_label
AI_MOCK_SCENARIO=ok

# --- Lưu ảnh (TD-01: dev lưu đĩa local; S3 khi deploy) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
# C4 UC02: tối đa 10 MB
STORAGE_MAX_BYTES=10485760
